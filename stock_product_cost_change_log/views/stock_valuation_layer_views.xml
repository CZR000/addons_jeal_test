<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_valuation_layer_tree" model="ir.ui.view">
        <field name="name">stock.valuation.layer.view.list.inherit.stock_product_cost_change_log</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
        <field name="arch" type="xml">
            <field name="unit_cost" position="after">
                <field name="standard_price" optional="show" groups="product_hide_price_cost.group_show_product_cost"/>
            </field>
        </field>
    </record>

    <record id="stock_valuation_layer_form" model="ir.ui.view">
        <field name="name">stock.valuation.layer.view.form.inherit.stock_product_cost_change_log</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_form"/>
        <field name="arch" type="xml">
            <field name="unit_cost" position="after">
                <field name="standard_price" groups="product_hide_price_cost.group_show_product_cost"/>
            </field>
        </field>
    </record>

</odoo>
