#. module: stock_date_effective
#: model:ir.model.fields,field_description:stock_date_effective.field_stock_valuation_layer__accounting_date
#: model:ir.model.fields,field_description:stock_date_effective.field_stock_move_line__accounting_date
msgid "Accounting Date"
msgstr "Fecha contable"

#. module: stock_date_effective
#: model:ir.model.fields,help:stock_date_effective.field_stock_move_line__accounting_date
msgid ""
"Accounting date obtained from the stock valuation layers associated with the move. "
"Allows editing the accounting date if the user has the necessary permissions. "
"Changes made are automatically propagated to all linked valuation layers."
msgstr ""
"Fecha contable obtenida de las capas de valoración de existencias asociadas al movimiento. "
"Permite editar la fecha contable si el usuario tiene el permiso necesario. "
"Los cambios realizados se propagan automáticamente a todas las capas de valoración vinculadas."

#. module: stock_date_effective
#. odoo-python
#: code:addons/stock_date_effective/models/stock_move_line.py:0
#, python-format
msgid "No negative quantities allowed"
msgstr "No se permiten cantidades negativas"

#. module: stock_date_effective
#: model:ir.model,name:stock_date_effective.model_stock_valuation_layer
msgid "Stock Valuation Layer"
msgstr "Capa de valoración de existencias"

#. module: stock_date_effective
#. odoo-python
#: code:addons/stock_date_effective/models/stock_move_line.py:0
#, python-format
msgid ""
"The quantity done for the product \"%s\" doesn't respect the rounding "
"precision defined on the unit of measure \"%s\". Please change the quantity "
"done or the rounding precision of your unit of measure."
msgstr ""
"La cantidad hecha para el producto \"%s\" no respeta la precisión de "
"redondeo que se definió en la unidad de medida \"%s\". Cambie la cantidad "
"hecha o la precisión de redondeo de su unidad de medida."

#. module: stock_date_effective
#. odoo-python
#: code:addons/stock_date_effective/models/stock_move.py:0
#, python-format
msgid ""
"You cannot move the same package content more than once in the same transfer"
" or split the same package into two location."
msgstr ""
"No puede mover el mismo contenido del paquete más de una vez en el mismo "
"traslado o dividir el mismo paquete en dos ubicaciones."

#. module: stock_date_effective
#. odoo-python
