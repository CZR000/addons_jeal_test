<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="stock_valuation_layer_form" model="ir.ui.view">
        <field name="name">stock.valuation.layer.view.form.inherit.stock_date_effective</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_form"/>
        <field name="arch" type="xml">
            <field name="create_date" position="after">
                <field name="accounting_date" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="stock_valuation_layer_tree" model="ir.ui.view">
        <field name="name">stock.valuation.layer.view.list.inherit.stock_date_effective</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_date']" position="after">
                <field name="accounting_date" readonly="1" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='remaining_value']" position="after">
                <button name="action_open_reference" type="object" title="Open Reference" icon="fa-eye"/>
            </xpath>
        </field>
    </record>

</odoo>
