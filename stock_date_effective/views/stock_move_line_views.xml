<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_line_tree" model="ir.ui.view">
        <field name="name">stock.move.line.view.list.inherit.stock_date_effective</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="accounting_date" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_form" model="ir.ui.view">
        <field name="name">stock.move.line.view.form.inherit.stock_date_effective</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="accounting_date" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="stock_move_line_view_search" model="ir.ui.view">
        <field name="name">stock.move.line.view.form.inherit.stock_date_effective</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_last_12_months']" position="after">
                <separator/>
                <filter name="accounting_date" date="accounting_date" default_period="month"/>
                <filter string="Últimos 30 días" name="accounting_date_30_days" domain="[('accounting_date','&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Últimos 3 meses" name="accounting_date_3_months" domain="[('accounting_date','&gt;=', (context_today() - relativedelta(months=3)).strftime('%Y-%m-%d'))]"/>
                <filter string="Últimos 12 meses" name="accounting_date_12_months" domain="[('accounting_date','&gt;=', (context_today() - relativedelta(years=1)).strftime('%Y-%m-%d'))]"/>
            </xpath>
            <xpath expr="//filter[@name='by_date']" position="after">
                <filter string="Fecha contable" name="by_accounting_date" domain="[]" context="{'group_by': 'accounting_date'}"/>
            </xpath>
        </field>
    </record>

</odoo>
