<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
         <field name="name">product.template.view.form.inherit.product_hide_price_cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//span[@name='uom_span']" position="attributes">
                <attribute name="groups">product_hide_price_cost.group_show_product_selling_price</attribute>
            </xpath>
             <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="groups">product_hide_price_cost.group_show_product_cost</attribute>
            </xpath>
            <field name="list_price" position="attributes">
                <attribute name="groups">product_hide_price_cost.group_show_product_selling_price</attribute>
            </field>
        </field>
    </record>

    <record id="product_template_kanban_view" model="ir.ui.view">
        <field name="name">product.template.view.kanban.inherit.product_hide_price_cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']//.." position="attributes">
                <attribute name="groups">product_hide_price_cost.group_show_product_selling_price</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view" model="ir.ui.view">
         <field name="name">product.template.view.tree.inherit.product_hide_price_cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="attributes">
                <attribute name="groups">product_hide_price_cost.group_show_product_selling_price</attribute>
            </field>
            <field name="standard_price" position="attributes">
                <attribute name="groups">product_hide_price_cost.group_show_product_cost</attribute>
            </field>
        </field>
    </record>

</odoo>
