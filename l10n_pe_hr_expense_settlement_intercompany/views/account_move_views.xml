<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n_pe_settlement_ic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert" invisible="not l10n_pe_ic_origin_partner_id">
                    Gasto rendido en <field name="l10n_pe_ic_origin_partner_id" class="d-inline fw-bold" readonly="1"/>
                    (informe <field name="l10n_pe_ic_origin_ref" class="d-inline" readonly="1"/>): esa empresa le pagó
                    al proveedor. Al publicar se registra la deuda con ella
                    <span invisible="not l10n_pe_ic_payable_move_id">
                        (<field name="l10n_pe_ic_payable_move_id" class="d-inline" readonly="1"/>)</span>.
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.move.search.l10n_pe_settlement_ic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="l10n_pe_ic_origin_partner_id"/>
                <field name="l10n_pe_ic_origin_ref"/>
            </field>
            <xpath expr="//filter[@name='status']" position="after">
                <filter name="group_ic_origin" string="Empresa de origen" context="{'group_by': 'l10n_pe_ic_origin_partner_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_l10n_pe_ic_received_expenses" model="ir.actions.act_window">
        <field name="name">Gastos recibidos de otras empresas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('l10n_pe_ic_origin_partner_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'create': False, 'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay gastos recibidos de otras empresas.</p>
            <p>Cuando un empleado de otra empresa del grupo rinde un comprobante emitido a esta empresa, aquí aparece
               la factura en borrador para revisarla y publicarla.</p>
        </field>
    </record>

    <menuitem id="menu_l10n_pe_ic_received_expenses"
              name="Gastos recibidos de otras empresas"
              parent="account.menu_finance_payables"
              action="action_l10n_pe_ic_received_expenses"
              sequence="15"/>

</odoo>
