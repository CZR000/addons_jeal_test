<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_expense_view_form" model="ir.ui.view">
        <field name="name">hr.expense.form.l10n_pe_settlement_ic</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="l10n_pe_hr_expense_settlement.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <field name="l10n_pe_in_purchase_register" position="before">
                <field name="l10n_pe_ic_allowed_partner_ids" invisible="1"/>
                <field name="l10n_pe_is_intercompany" invisible="1"/>
                <field name="l10n_pe_ic_vat_mismatch" invisible="1"/>
                <field name="l10n_pe_charged_partner_id"
                       invisible="payment_mode != 'own_account' or l10n_pe_is_advance_refund"
                       readonly="not is_editable"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="l10n_pe_ic_customer_vat"
                       invisible="not l10n_pe_is_intercompany"
                       required="l10n_pe_is_intercompany"
                       readonly="not is_editable"
                       placeholder="RUC que figura como cliente en el comprobante"/>
            </field>
            <field name="l10n_pe_refund_payment_id" position="after">
                <field name="l10n_pe_ic_move_id" invisible="not l10n_pe_ic_move_id"/>
                <field name="l10n_pe_ic_bill_ref" invisible="not l10n_pe_ic_bill_ref"/>
            </field>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert" invisible="not l10n_pe_is_intercompany">
                    Comprobante de <field name="l10n_pe_charged_partner_id" class="d-inline fw-bold" readonly="1"/>:
                    aquí no se registra factura; queda una cuenta por cobrar a esa empresa y allá se crea la factura
                    en borrador para que la revise su contadora.
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="not l10n_pe_ic_vat_mismatch">
                    El RUC del adquiriente no es el de la empresa que asume el gasto: verifique que el comprobante se
                    emitió a ese RUC.
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_hr_expense_sheet_form" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.l10n_pe_settlement_ic</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="l10n_pe_hr_expense_settlement.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_l10n_pe_open_ic_moves" type="object" class="oe_stat_button"
                        icon="fa-exchange" invisible="not l10n_pe_ic_move_count">
                    <field name="l10n_pe_ic_move_count" widget="statinfo" string="Intercompany"/>
                </button>
            </div>
            <xpath expr="//field[@name='expense_line_ids']/list/field[@name='l10n_pe_document_reference']" position="after">
                <field name="l10n_pe_charged_partner_id" optional="show" string="Asume"
                       column_invisible="parent.payment_mode != 'own_account'"/>
                <field name="l10n_pe_ic_vat_mismatch" column_invisible="1"/>
                <field name="l10n_pe_ic_customer_vat" optional="hide" string="RUC adquiriente"
                       decoration-warning="l10n_pe_ic_vat_mismatch"
                       column_invisible="parent.payment_mode != 'own_account'"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="l10n_pe_ic_vat_warning" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert" invisible="not l10n_pe_ic_vat_warning">
                    <field name="l10n_pe_ic_vat_warning" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
