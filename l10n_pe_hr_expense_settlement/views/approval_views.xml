<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_category_view_form" model="ir.ui.view">
        <field name="name">approval.category.form.l10n_pe_settlement</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="je_approval_expense_flow.approval_category_view_form_je"/>
        <field name="arch" type="xml">
            <field name="default_means_payment_id" position="after">
                <field name="l10n_pe_advance_kind" invisible="approval_type != 'payment'"/>
                <field name="l10n_pe_payment_journal_ids" widget="many2many_tags"
                       invisible="approval_type != 'payment' or not l10n_pe_advance_kind"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.form.l10n_pe_settlement</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="l10n_pe_advance_kind" invisible="1"/>
                <field name="l10n_pe_currency_id"
                       invisible="not l10n_pe_advance_kind"
                       required="l10n_pe_advance_kind"
                       readonly="request_status != 'new'"
                       options="{'no_create': True}"/>
                <field name="l10n_pe_employee_id"
                       invisible="not l10n_pe_advance_kind"
                       readonly="request_status != 'new'"
                       options="{'no_create': True}"/>
                <field name="l10n_pe_expense_sheet_id" invisible="not l10n_pe_expense_sheet_id"/>
            </field>
            <xpath expr="//sheet" position="before">
                <field name="l10n_pe_pending_advance_warning" invisible="1"/>
                <field name="l10n_pe_can_override_block" invisible="1"/>
                <field name="l10n_pe_block_override_user_id" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert" invisible="not l10n_pe_pending_advance_warning or l10n_pe_block_override_user_id">
                    <field name="l10n_pe_pending_advance_warning" readonly="1"/>
                    <div invisible="not l10n_pe_can_override_block">
                        <label for="l10n_pe_block_override_reason"/>
                        <field name="l10n_pe_block_override_reason" placeholder="Motivo por el que se autoriza el desembolso"/>
                    </div>
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="not l10n_pe_block_override_user_id">
                    Desembolso con rendiciones pendientes autorizado por
                    <field name="l10n_pe_block_override_user_id" class="d-inline fw-bold" readonly="1"/>:
                    <field name="l10n_pe_block_override_reason" class="d-inline" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
