<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.l10n_pe_settlement_block</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="l10n_pe_pending_advance_warning" invisible="1"/>
                <field name="l10n_pe_can_override_block" invisible="1"/>
                <field name="l10n_pe_block_override_user_id" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert" invisible="not l10n_pe_pending_advance_warning or l10n_pe_block_override_user_id">
                    <field name="l10n_pe_pending_advance_warning" readonly="1"/>
                    <div invisible="not l10n_pe_can_override_block">
                        <label for="l10n_pe_block_override_reason"/>
                        <field name="l10n_pe_block_override_reason" placeholder="Motivo por el que se autoriza el desembolso"/>
                    </div>
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="not l10n_pe_block_override_user_id">
                    Desembolso con rendiciones pendientes autorizado por
                    <field name="l10n_pe_block_override_user_id" class="d-inline fw-bold" readonly="1"/>:
                    <field name="l10n_pe_block_override_reason" class="d-inline" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
