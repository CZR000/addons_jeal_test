<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_kardex_adjustment" model="ir.ui.view">
        <field name="name">account.move.form.kardex.adjustment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_kardex_adjustment_run" type="object" class="oe_stat_button"
                        icon="fa-cubes" invisible="not kardex_adjustment_run_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Proceso de kardex</span>
                    </div>
                </button>
            </div>
            <group id="header_right_group" position="inside">
                <field name="kardex_adjustment" invisible="not kardex_adjustment"/>
                <field name="kardex_adjustment_type" invisible="not kardex_adjustment"/>
                <field name="kardex_adjustment_run_id" invisible="not kardex_adjustment"/>
                <field name="kardex_adjusted_layer_id" invisible="not kardex_adjustment"
                       groups="base.group_no_one"/>
                <field name="kardex_adjusted_stock_move_id" invisible="not kardex_adjustment"
                       groups="stock.group_stock_user"/>
            </group>
        </field>
    </record>

    <record id="view_move_tree_kardex_adjustment" model="ir.ui.view">
        <field name="name">account.move.list.kardex.adjustment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="kardex_adjustment" optional="hide"/>
                <field name="kardex_adjustment_type" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_move_filter_kardex_adjustment" model="ir.ui.view">
        <field name="name">account.move.select.kardex.adjustment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <filter name="to_check" position="after">
                <separator/>
                <filter string="Ajustes por kardex" name="kardex_adjustment"
                        domain="[('kardex_adjustment', '=', True)]"/>
                <filter string="Sin ajustes por kardex" name="no_kardex_adjustment"
                        domain="[('kardex_adjustment', '=', False)]"/>
            </filter>
            <filter name="status" position="after">
                <filter string="Tipo de ajuste kardex" name="group_kardex_adjustment_type"
                        context="{'group_by': 'kardex_adjustment_type'}"/>
            </filter>
        </field>
    </record>

    <record id="view_move_line_tree_kardex_adjustment" model="ir.ui.view">
        <field name="name">account.move.line.list.kardex.adjustment</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="kardex_adjustment" optional="hide"/>
                <field name="kardex_adjustment_type" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_move_line_filter_kardex_adjustment" model="ir.ui.view">
        <field name="name">account.move.line.search.kardex.adjustment</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <filter name="to_check" position="after">
                <separator/>
                <filter string="Ajustes por kardex" name="kardex_adjustment"
                        domain="[('kardex_adjustment', '=', True)]"/>
                <filter string="Sin ajustes por kardex" name="no_kardex_adjustment"
                        domain="[('kardex_adjustment', '=', False)]"/>
            </filter>
            <filter name="journal" position="after">
                <filter string="Tipo de ajuste kardex" name="group_kardex_adjustment_type"
                        context="{'group_by': 'kardex_adjustment_type'}"/>
            </filter>
        </field>
    </record>

</odoo>
