<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Solicitud al aprobador -->
    <record id="mail_tmpl_credit_request" model="mail.template">
        <field name="name">Crédito: solicitud de aprobación</field>
        <field name="model_id" ref="model_sale_credit_approval_request"/>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="email_to">{{ object.approver_id.email }}</field>
        <field name="subject">Aprobar crédito: {{ object.partner_id.name }} · {{ object.currency_id.format(object.amount_pen) }} · {{ object.order_id.name }}</field>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;color:#1a1a1a;max-width:560px;">
                <p style="margin:0 0 16px 0;">
                    <strong t-out="object.user_id.name or ''">Vendedor</strong>
                    solicita aprobar una venta al crédito.
                </p>
                <t t-set="reasons" t-value="object._get_reason_lines()"/>
                <div t-if="reasons" style="background:#fff4d6;border-left:4px solid #e0a800;padding:10px 14px;margin:0 0 16px 0;">
                    <t t-if="len(reasons) == 1">
                        <strong>Motivo:</strong> <t t-out="reasons[0]"/>
                    </t>
                    <t t-else="">
                        <strong>Motivos:</strong>
                        <ul style="margin:4px 0 0 18px;padding:0;">
                            <li t-foreach="reasons" t-as="reason" t-out="reason"/>
                        </ul>
                    </t>
                </div>
                <table style="border-collapse:collapse;margin:0 0 20px 0;">
                    <tr>
                        <td style="padding:3px 16px 3px 0;color:#666;">Cliente</td>
                        <td><t t-out="object.partner_id.name or ''"/><t t-if="object.partner_id.vat"> · RUC <t t-out="object.partner_id.vat"/></t></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 16px 3px 0;color:#666;">Cotización</td>
                        <td t-out="object.order_id.name or ''"/>
                    </tr>
                    <tr>
                        <td style="padding:3px 16px 3px 0;color:#666;">Esta venta</td>
                        <td><strong t-out="object.currency_id.format(object.amount_pen)"/></td>
                    </tr>
                    <tr>
                        <td style="padding:3px 16px 3px 0;color:#666;">Crédito disponible</td>
                        <td t-out="object._get_available_text()"/>
                    </tr>
                </table>
                <p style="margin:0 0 16px 0;">
                    <a t-att-href="object._get_public_url('approve')"
                       style="background:#157347;color:#fff;padding:10px 22px;text-decoration:none;border-radius:4px;margin-right:12px;display:inline-block;">Aprobar</a>
                    <a t-att-href="object._get_public_url('reject')"
                       style="background:#b02a37;color:#fff;padding:10px 22px;text-decoration:none;border-radius:4px;display:inline-block;">Rechazar</a>
                </p>
                <p style="color:#666;font-size:12px;margin:0;">
                    Este enlace sirve una sola vez y vence el <t t-out="object._format_expiry()"/>.
                </p>
            </div>
        </field>
        <field name="lang">{{ object.approver_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
    </record>

    <!-- Crédito aprobado (al vendedor) -->
    <record id="mail_tmpl_credit_approved" model="mail.template">
        <field name="name">aprobado</field>
        <field name="model_id" ref="model_sale_credit_approval_request"/>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="email_to">{{ object.user_id.email }}</field>
        <field name="subject">Crédito aprobado – {{ object.order_id.name }}</field>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;color:#1a1a1a;">
                <p>La solicitud <strong t-out="object.name or ''"/> de la
                    cotización <strong t-out="object.order_id.name or ''"/> fue
                    <strong style="color:#157347;">APROBADA</strong> por
                    <t t-out="object.approver_id.name or ''"/>.</p>
                <p>Ya puede confirmar la cotización.</p>
            </div>
        </field>
        <field name="lang">{{ object.user_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
    </record>

    <!-- Crédito rechazado (al vendedor) -->
    <record id="mail_tmpl_credit_rejected" model="mail.template">
        <field name="name">rechazado</field>
        <field name="model_id" ref="model_sale_credit_approval_request"/>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="email_to">{{ object.user_id.email }}</field>
        <field name="subject">Crédito rechazado – {{ object.order_id.name }}</field>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;color:#1a1a1a;">
                <p>La solicitud <strong t-out="object.name or ''"/> de la
                    cotización <strong t-out="object.order_id.name or ''"/> fue
                    <strong style="color:#b02a37;">RECHAZADA</strong> por
                    <t t-out="object.approver_id.name or ''"/>.</p>
                <p><strong>Motivo:</strong> <t t-out="object.rejection_reason or ''"/></p>
            </div>
        </field>
        <field name="lang">{{ object.user_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
    </record>

    <!-- Solicitud vencida (al vendedor) -->
    <record id="mail_tmpl_credit_expired" model="mail.template">
        <field name="name">solicitud vencida</field>
        <field name="model_id" ref="model_sale_credit_approval_request"/>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="email_to">{{ object.user_id.email }}</field>
        <field name="subject">Solicitud de crédito vencida – {{ object.order_id.name }}</field>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;color:#1a1a1a;">
                <p>La solicitud <strong t-out="object.name or ''"/> de la
                    cotización <strong t-out="object.order_id.name or ''"/>
                    venció sin respuesta del aprobador.</p>
                <p>Puede reenviar la solicitud desde la cotización con un enlace
                    nuevo (se recalcula con la deuda del momento).</p>
            </div>
        </field>
        <field name="lang">{{ object.user_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>
